{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "WebWorker"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node", "@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "skipLibCheck": true
  },
  "include": ["src", "test", "evals", "worker-configuration.d.ts", "vitest.config.ts", "eslint.config.js"]
}
