{
  // Tutor-only profile (AXO-126, internal stage). Same worker name and the same D1/KV as
  // wrangler.jsonc, without the document pipeline: no DOCUMENT_VISION service, no paper queue or
  // consumer, no artifact bucket. The document routes are not part of this stage, and nothing
  // binds to document-vision until it is admitted to the deployment plan.
  //
  // GEMINI_PRIVACY_MODE is "paid_no_training": the key is on the Google AI Studio paid tier, so
  // Google does not train on the data and keeps it for a bounded period that the Privacy Policy
  // declares (owner decision, 7 Oct 2026, Axon.md §11; AXO-126). It is not zero retention. "zdr" is
  // an attestation that a written Google zero-data-retention arrangement covers the key; it is made
  // by the owner, never by this repo's tooling. Any other value fails closed with
  // NO_COMPLIANT_PROVIDER (docs/TUTOR_SECURITY.md, Boundary D).
  //
  // Secrets, set with `wrangler secret put` (never committed): GOOGLE_API_KEY, AXON_INTERNAL_TOKEN,
  // AXON_ADMIN_TOKEN, AXON_PSEUDONYM_KEY, SUPABASE_SECRET_KEY; optional TAVILY_API_KEY, FIRECRAWL_API_KEY.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axon-intelligence",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AXON_DEPLOYMENT_SHA": "development",
    "AXON_CONFIG_REVISION": "v3.default",
    "AXON_PIPELINE_VERSION": "3.0.0",
    "GEMINI_PRIVACY_MODE": "paid_no_training",
    "AXON_VISION_PRIVACY_MODE": "unverified",
    "TAVILY_API_BASE": "https://api.tavily.com",
    "SUPABASE_URL": "https://dlgcqieyevoebefhcggi.supabase.co",
    // gemini-3.8-flash standard rates, USD per 1M tokens, valid through 2026-12-31. They double on
    // 2027-01-01 (input 1.50, output 7.50): update these then, or Tutor cost is understated.
    "GEMINI_INPUT_USD_PER_MILLION": "0.75",
    "GEMINI_OUTPUT_USD_PER_MILLION": "3.75"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "axon-intelligence",
      "database_id": "f4d5b07c-f960-45e3-b25a-f56bab682fe2",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PIPELINE_CACHE",
      "id": "c1a921d9e8f049e6b88e48ad71bd8277"
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
